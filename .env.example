# Host ports, Nginx Proxy Manager style: 80 = HTTP, 443 = HTTPS, 81 = dashboard.
# If you change BEARUST_HTTPS_PORT, set server.https_public_port to match.
BEARUST_HTTP_PORT=80
BEARUST_HTTPS_PORT=443
BEARUST_CONTROL_PORT=81
# The dashboard is loopback-only by default. Set to 0.0.0.0 to reach it from
# other machines (only behind a firewall/VPN; it is the admin interface).
# BEARUST_CONTROL_HOST=127.0.0.1
# Local builds tag the image bearust:local. To run a prebuilt release from
# the GitHub Container Registry instead, use e.g.
# BEARUST_IMAGE=ghcr.io/bearust/bearust:latest (or a pinned :vX.Y.Z tag).
BEARUST_IMAGE=bearust:local
BEARUST_CONFIG=./config/bearust.example.toml
RUST_LOG=info
# ACME is configured from the authenticated control-plane UI/API. Keep the
# management listener loopback-only and put it behind HTTPS in production.
# Set this once to avoid the generated setup token on first startup.
# BEARUST_SETUP_TOKEN=replace-with-a-long-random-value

# Optional external control-plane database profiles. Leave DATABASE_URL unset
# for the default SQLite database in the Compose-managed bearust-data volume.
# DATABASE_URL=postgres://bearust:change-me-in-development@postgres:5432/bearust
# POSTGRES_USER=bearust
# POSTGRES_PASSWORD=change-me-in-development
# POSTGRES_DB=bearust
# DATABASE_URL=mysql://bearust:change-me-in-development@mysql:3306/bearust
# MYSQL_USER=bearust
# MYSQL_PASSWORD=change-me-in-development
# MYSQL_DATABASE=bearust
# MYSQL_ROOT_PASSWORD=change-me-in-development

# Optional Multi-Node Cluster Configuration (Phase 10A)
# NODE_ID=node1
# CLUSTER_PEERS=node2=127.0.0.1:9092,node3=127.0.0.1:9093
# CLUSTER_AUTH_TOKEN=replace-with-a-random-32-byte-or-longer-secret
